.DS_Store
images/.DS_Store

# Claude SEO toolchain — rebuilt per-session by .claude/hooks/setup-seo.sh
.claude/skills/seo/.venv/
.claude/hooks/setup-seo.log
__pycache__/
*.pyc
# Local credentials must never be committed
.claude/**/client_secret*.json
.claude/**/oauth-token.json
.claude/**/service_account*.json

# Worker dependencies (installed by npm install in mast-backend/)
mast-backend/node_modules/
mast-backend/package-lock.json

# The range address is private and this repo is public: the plaintext directions PDF never enters git (seal it: mast-backend/seal-directions.mjs)
mast-backend/assets/*irections*.pdf
MAST_Range_Directions*.pdf
